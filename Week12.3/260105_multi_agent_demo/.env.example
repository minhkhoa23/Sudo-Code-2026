# Copy to .env, enter keys here; never paste keys into chat or commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# USD / 1M tokens; standard paid text rates, checked 2026-10-29.
# Estimates, not an invoice; update when changing model or pricing tier.
INPUT_USD_PER_MILLION=0.25
OUTPUT_USD_PER_MILLION=1.50
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Optional absolute folder. Default: runtime/ inside this project.
DEMO_DATA_DIR=
